{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "botanical-research-database",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botany-db",
      "database_id": "7f6e9aa2-61ba-4406-bbd9-3ed2e20e495b",
      "migrations_dir": "migrations"
    }
  ]
}
